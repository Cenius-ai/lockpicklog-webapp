# LockpickLog reads its settings straight from the environment.
# Copy this file to .env only if your shell or process manager loads dotenv
# files; everything here is optional and the tool works with no .env at all.

# Path to the JSON log. Empty means the default: $HOME/.lockpicklog/data.json
LOCKPICKLOG_DATA=

# Set to any value to disable ANSI colour (an empty value keeps the default,
# which is colour only on an interactive terminal).
NO_COLOR=
